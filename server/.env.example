# Copy this file to .env and fill in the real values.
# Never commit .env — it's already in .gitignore.

# From Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on that same OAuth client.
# For local development this is fine as-is.
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Port the backend listens on.
PORT=8787

# Origin the frontend dev server runs on, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Interim data source (average rating + a few public reviews) while
# Business Profile API access is pending. From Cloud Console → APIs &
# Services → Credentials → API key, restricted to "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Powers the AI-written narrative summary on the Rapportage page (see
# reportSummary.ts). From platform.openai.com → API Keys. Optional —
# without it, that one section is simply unavailable; everything else on
# the page (tables, pot calculation) works regardless.
OPENAI_API_KEY=

# The AI features stay off ("Binnenkort beschikbaar") until this is "true",
# even with a key set — turn it on once the OpenAI account has credits.
AI_ENABLED=

# Named logins with their own permissions (replaces BETA_USER/BETA_PASSWORD
# once set). One account per entry, separated by ";":
#   gebruikersnaam:wachtwoordhash:rechten
# Rights: "reply" (reviews beantwoorden + AI-opzet) and "ai" (AI-chat +
# AI-samenvatting), comma-separated; leave empty for view-only. Make the
# hash with: node server/dist/hashPassword.js '<wachtwoord>'
# Example: rick:scrypt$abc$def:reply,ai;team:scrypt$ghi$jkl:
DASHBOARD_USERS=

# Optional: secret that signs the login cookie. Without it one is generated
# and kept on the persistent volume (.data/session-secret). Changing it logs
# everyone out.
SESSION_SECRET=
